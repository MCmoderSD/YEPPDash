# Template for the gitignored .env that docker-compose.yaml reads. Copy it to .env and fill in the
# values; nothing here is a real credential.
#
#   cp .env.example .env
#
# Only the compose file consumes these. Running the backend from an IDE takes its configuration
# from user secrets or appsettings.Local.json instead, under the plain ASP.NET key names
# (ConnectionStrings:HelixDev and so on) rather than the double-underscore spelling below.

# Which set of connection strings and Twitch credentials the backend picks up, by suffixing the
# key names with it: Dev or Prod. Defaults to Dev when unset.
#
# Only the four values carrying that suffix have to be filled in — the other set can stay empty,
# it is never read. Leaving one of the four blank is what stops the container at startup.
DB_TARGET=Dev

# Development or Production. Development additionally lets the backend read user secrets and
# appsettings.Local.json. Defaults to Development when unset.
ASPNETCORE_ENVIRONMENT=Development

# YEPPBot's own MariaDB schema, which it owns and migrates. YEPPDash only reads and writes the
# tables it already has — quotes, birthdays, custom commands, BDSM results, raid events.
CONNECTIONSTRINGS__HELIXDEV=Server=127.0.0.1;Port=3306;Database=helix;User=yeppdash;Password=;
CONNECTIONSTRINGS__HELIXPROD=Server=127.0.0.1;Port=3306;Database=helix;User=yeppdash;Password=;

# YEPPDash's own schema, holding the TwitchToken and Wheel tables and the Spotify ones. Kept apart
# from the bot's because the encrypted OAuth tokens are the one thing YEPPDash owns outright.
CONNECTIONSTRINGS__YEPPDASHDEV=Server=127.0.0.1;Port=3306;Database=yeppdash;User=yeppdash;Password=;
CONNECTIONSTRINGS__YEPPDASHPROD=Server=127.0.0.1;Port=3306;Database=yeppdash;User=yeppdash;Password=;

# The Twitch application the OAuth flow runs against, from dev.twitch.tv/console/apps. The secret
# is also what the YEPPBot API key is derived from, so a blank one takes the bot link with it.
TWITCH__CLIENTIDDEV=
TWITCH__CLIENTSECRETDEV=
TWITCH__CLIENTIDPROD=
TWITCH__CLIENTSECRETPROD=

# Has to be registered on that same Twitch application character for character.
TWITCH__REDIRECTURI=https://api.yeppbot.com/auth/callback

# The Spotify application from developer.spotify.com/dashboard. Entirely optional: leave these blank
# and the backend still starts, every other feature is untouched, and the Spotify page says the
# server has no credentials for it.
#
# Spotify hands out one client id per developer, so the local and the deployed callback are two
# redirect URIs on the same application rather than two applications. Note that Spotify refuses the
# hostname "localhost" entirely — only an explicit loopback literal like 127.0.0.1 is accepted, and
# HTTP is permitted for that one case. Controlling playback also needs a Premium account, which
# Spotify no longer lets anyone check for in advance.
SPOTIFY__CLIENTIDDEV=
SPOTIFY__CLIENTSECRETDEV=
SPOTIFY__CLIENTIDPROD=
SPOTIFY__CLIENTSECRETPROD=

# Has to be registered on that same Spotify application character for character.
SPOTIFY__REDIRECTURIDEV=http://127.0.0.1:5088/spotify/callback
SPOTIFY__REDIRECTURIPROD=https://api.yeppbot.com/spotify/callback

# Origins the API answers CORS for and accepts as a post-login return target. Indexed rather than
# comma-separated because that is how ASP.NET binds a configuration array from the environment.
ALLOWEDFRONTENDORIGINS__0=https://dash.yeppbot.com
ALLOWEDFRONTENDORIGINS__1=https://www.yeppbot.com
ALLOWEDFRONTENDORIGINS__2=https://yeppbot.com
