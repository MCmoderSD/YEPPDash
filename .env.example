# Copy to .env (already gitignored) and fill in real values. Never commit .env.

# Which MariaDB server the backend container actually talks to: Dev or Prod.
# Both connection strings below are always configured; this just picks one,
# so the same image can be pointed at either without a rebuild.
DB_TARGET=Dev

# Dev MariaDB (10.10.10.1) — yeppdash_ro, SELECT-only on helix.User/helix.Channel
CONNECTIONSTRINGS__HELIXDEV=Server=10.10.10.1;Port=3306;Database=helix;User=yeppdash_ro;Password=CHANGE_ME;

# Prod MariaDB (dedi.mcmodersd.de) — yeppdash_ro, SELECT-only on helix.User/helix.Channel
CONNECTIONSTRINGS__HELIXPROD=Server=dedi.mcmodersd.de;Port=3306;Database=helix;User=yeppdash_ro;Password=CHANGE_ME;
