{
  "Logging": {
    "LogLevel": {
      // Information is meant to be readable: what changed, not what was read. Anything that fires
      // once per page load lives at Debug, so turning this to "Debug" brings the detail back.
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",

      // One line per request, and the single knob for all of them — set it to "Warning" for silence
      // without losing the failures, since a 5xx is logged at Error.
      "YEPPDash.Api.Requests": "Information"
    }
  },
  "AllowedHosts": "*",

  // Optional. Without ClientId/ClientSecret (user secrets or appsettings.Local.json) every Spotify
  // endpoint answers "not configured" and nothing else changes. Spotify hands out one client id per
  // developer, so the loopback and the deployed URI are two redirect URIs on the same app.
  //
  // The dev URI is the plain-HTTP loopback on purpose. Spotify refuses the hostname "localhost"
  // outright and permits HTTP only for an explicit loopback literal, so 127.0.0.1 it is — and over
  // HTTP, because the dev certificate is issued for "localhost" and would warn on any other name.
  // The callback carries its state in the query string rather than in a cookie precisely so that
  // landing on a different host than the session was issued for costs nothing.
  "Spotify": {
    "RedirectUriDev": "http://127.0.0.1:5088/spotify/callback",
    "RedirectUriProd": "https://api.yeppbot.com/spotify/callback"
  },

  "YeppBot": {
    "BaseUrlDev": "https://localhost:420/api",
    "BaseUrlProd": "https://dedi.mcmodersd.de:420/api",

    // Locally the bot serves its own certificate, which is either self-signed or issued for the
    // deployed host — neither validates as "localhost", so the dev link only works without the
    // check. Scoped to this one client, so nothing else in the app stops validating.
    "AllowUntrustedCertificateDev": true
  }
}
