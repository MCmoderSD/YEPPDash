<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3"/>
        <add key="Nexus" value="https://mcmodersd.de/nexus/repository/nuget-hosted/" protocolVersion="2"/>
    </packageSources>
    <packageSourceMapping>
        <packageSource key="Nexus">
            <package pattern="BDSM-Test-API"/>
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*"/>
        </packageSource>
    </packageSourceMapping>
</configuration>