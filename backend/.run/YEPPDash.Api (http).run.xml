<component name="ProjectRunConfigurationManager">
  <!--
    Shared Rider run configuration, see YEPPDash.Api (https).run.xml for why this is a
    "LaunchSettings" configuration rather than a plain project one.

    Note: the Twitch app currently only has https://localhost:7218/api/auth/callback
    registered as a redirect URI (see PLAN.md#auth), not the http://localhost:5088 one this
    profile would produce. The auth flow will fail with a Twitch-side redirect_uri mismatch
    through this profile until http://localhost:5088/api/auth/callback is added there too —
    use the (https) configuration for auth testing until then.
  -->
  <configuration default="false" name="YEPPDash.Api (http)" type="LaunchSettings" factoryName=".NET Launch Settings Profile">
    <option name="LAUNCH_PROFILE_PROJECT_FILE_PATH" value="$PROJECT_DIR$/YEPPDash.Api/YEPPDash.Api.csproj" />
    <option name="LAUNCH_PROFILE_TFM" value="net10.0" />
    <option name="LAUNCH_PROFILE_NAME" value="http" />
    <option name="USE_MONO" value="0" />
    <option name="RUNTIME_ARGUMENTS" value="" />
    <option name="GENERATE_APPLICATIONHOST_CONFIG" value="1" />
    <option name="SHOW_IIS_EXPRESS_OUTPUT" value="0" />
    <option name="SEND_DEBUG_REQUEST" value="1" />
    <option name="ADDITIONAL_IIS_EXPRESS_ARGUMENTS" value="" />
    <option name="AUTO_ATTACH_CHILDREN" value="0" />
    <option name="MIXED_MODE_DEBUG" value="0" />
    <method v="2">
      <option name="Build" />
    </method>
  </configuration>
</component>
