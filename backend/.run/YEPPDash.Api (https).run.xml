<component name="ProjectRunConfigurationManager">
  <!--
    Shared Rider run configuration. Lives in .run/ (committed) rather than .idea/ (gitignored),
    so everyone gets the same one.

    It is deliberately a "LaunchSettings" configuration bound to the "https" profile rather than
    a plain project configuration: running the built .exe directly does not apply
    Properties/launchSettings.json, which means ASPNETCORE_ENVIRONMENT stays unset and Kestrel
    falls back to port 5000. That breaks Twitch auth, because the redirect URI registered with
    the Twitch app is https://localhost:7218/api/auth/callback.
  -->
  <configuration default="false" name="YEPPDash.Api (https)" type="LaunchSettings" factoryName=".NET Launch Settings Profile">
    <option name="LAUNCH_PROFILE_PROJECT_FILE_PATH" value="$PROJECT_DIR$/YEPPDash.Api/YEPPDash.Api.csproj" />
    <option name="LAUNCH_PROFILE_TFM" value="net10.0" />
    <option name="LAUNCH_PROFILE_NAME" value="https" />
    <option name="USE_MONO" value="0" />
    <option name="RUNTIME_ARGUMENTS" value="" />
    <option name="GENERATE_APPLICATIONHOST_CONFIG" value="1" />
    <option name="SHOW_IIS_EXPRESS_OUTPUT" value="0" />
    <option name="SEND_DEBUG_REQUEST" value="1" />
    <option name="ADDITIONAL_IIS_EXPRESS_ARGUMENTS" value="" />
    <option name="AUTO_ATTACH_CHILDREN" value="0" />
    <option name="MIXED_MODE_DEBUG" value="0" />
    <method v="2">
      <option name="Build" />
    </method>
  </configuration>
</component>
