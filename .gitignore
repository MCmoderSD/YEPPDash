docker-compose.override.yml

# ── Secrets / local config (never commit real credentials) ──
# Blanket-ignore every environment-flavored appsettings file (Local, Production, Staging,
# whatever gets added later) so a stray one with real credentials can't be committed by
# accident. The two base files are checked in on purpose — no secrets in either, just
# non-sensitive defaults (DbTarget, logging) — so they're explicitly un-ignored again.
appsettings.*.json
!appsettings.json
!appsettings.Development.json
*.local.json
.env
.env.*
!.env.example
# Local HTTPS dev certificate, exported from `dotnet dev-certs` — machine-specific, regenerable.
.certs/
*.pem
*.key

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Claude Code local session/tool state ─────────────────────
.claude/